# Copy this file to .env and add your API key locally.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# Node 直连被本机网络重置时，可改为 python 使用系统网络连接。
AI_HTTP_TRANSPORT=python
# 图片服务可在网站的「AI 服务设置」中填写，使用独立的图片服务密钥。
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1.5
# 视频服务也可以在网站的「AI 服务设置」中填写并保存在本机。
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
XIANGONG_COMFY_URL=
XIANGONG_COMFY_TOKEN=
PORT=4317
